# =============================================================================
# AI Agent System — Environment Variables
# Copy this file to .env and fill in the required values.
# Required fields are marked [REQUIRED]. Everything else has a safe default.
# =============================================================================

# =============================================================================
# CORE API KEYS
# =============================================================================

# [REQUIRED] OpenRouter — primary LLM gateway for all model tiers
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# [REQUIRED] Backend API key — used to authenticate CLI, Telegram bot, and web UI
# Generate any strong random string: openssl rand -hex 32
BACKEND_API_KEY=sk-agent-your-key-here

# OpenAI — used ONLY for memory embeddings (pgvector semantic search)
# Leave blank to fall back to PostgreSQL full-text search
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# DATABASE
# =============================================================================

# [REQUIRED] PostgreSQL connection string
# Local dev:  postgresql://postgres:password@localhost:5432/agent_db
# Supabase:   copy from Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_db

# Supabase (optional — only needed if using Supabase-specific features)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional — enables durable deferred task queue; falls back to in-process)
REDIS_URL=

# =============================================================================
# TELEGRAM BOT
# =============================================================================

# [REQUIRED for Telegram] Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# [REQUIRED for Telegram] Your personal Telegram chat ID (for budget alerts)
# Find yours by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# Optional: separate API key for the Telegram bot (defaults to BACKEND_API_KEY)
TELEGRAM_BOT_API_KEY=

# =============================================================================
# TOOLS
# =============================================================================

# SearXNG — self-hosted search engine for web_search tool
# Default assumes local Docker instance; update for VPS deployment
SEARXNG_URL=http://localhost:8888

# Brave Search — fallback web search if SearXNG is unavailable
# Get your key at: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# E2B — sandboxed code execution for code_execution tool
# [REQUIRED for code_execution] Get your key at: https://e2b.dev
# Without this key, code_execution returns a helpful error instead of running code
E2B_API_KEY=

# Playwright browser automation — no key needed, just install:
#   pip install playwright && playwright install chromium
# deploy.sh does this automatically on VPS deployments.
# BROWSER_AUTOMATION_ALLOWED_HOST_SUFFIXES controls which hosts the agent can visit.
# Leave blank to allow all (with SSRF protection); comma-separated to restrict:
# BROWSER_AUTOMATION_ALLOWED_HOST_SUFFIXES=wikipedia.org,.github.io,docs.python.org
BROWSER_AUTOMATION_ALLOWED_HOST_SUFFIXES=

# GitHub — used by github_connector tool and GitHub MCP server
# Create at: https://github.com/settings/tokens (repo scope recommended)
GITHUB_TOKEN=

# =============================================================================
# MCP SERVERS
# =============================================================================
# These are read by the GitHub MCP server and Google Workspace MCP server.
# See agent_pillars.yaml tools.mcp.servers for the full server list.

# Google Workspace MCP (Gmail, Calendar, Drive)
# Run `npx mcp-server-google-workspace auth` to generate these after installing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Notion MCP
# Create an integration at: https://www.notion.so/profile/integrations
NOTION_API_KEY=

# =============================================================================
# BUDGET & COSTS
# =============================================================================

# Monthly LLM spend cap in USD. Agent refuses expensive tools when near limit.
OPENROUTER_BUDGET_MONTHLY=30.0

# Optional: webhook URL for budget alerts (Slack/Discord/custom)
ALERT_WEBHOOK_URL=

# =============================================================================
# SECURITY & DEPLOYMENT
# =============================================================================

# Public URL of this deployment (used in MCP server headers and CORS)
SITE_URL=http://localhost:3003

# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=["http://localhost:3003","https://yourdomain.com"]

# Workspace directory for file_operations tool
AGENT_WORKSPACE_DIR=/tmp/agent-workspace

ENVIRONMENT=production

# =============================================================================
# LEARNING FEATURES (optional)
# =============================================================================

# Dialectic user modeling — synthesizes memories into a user portrait after each task
# Adds one cheap LLM call per task (respects 30-min cooldown). Default: off.
AGENT_DIALECTIC_REFLECTION=false

# Quality scoring — samples agent responses and scores them for quality tracking
# Adds cost per sampled response. Default: off.
QUALITY_SCORING_ENABLED=false
QUALITY_SCORING_SAMPLE_RATE=0.10

# =============================================================================
# MODEL OVERRIDES (optional)
# =============================================================================
# Override any routing tier's model. Defaults are set in config.py.
# Uncomment and edit to swap a model without touching code.

# DEFAULT_MODEL_FREE=meta-llama/llama-3.3-70b-instruct:free
# DEFAULT_MODEL_SIMPLE=deepseek/deepseek-chat
# DEFAULT_MODEL_CODING=deepseek/deepseek-chat
# DEFAULT_MODEL_RESEARCH=google/gemini-2.5-flash
# DEFAULT_MODEL_ADVANCED=anthropic/claude-haiku-4.5
# DEFAULT_MODEL_PREMIUM=anthropic/claude-sonnet-4.6
# DEFAULT_MODEL_AGENT=anthropic/claude-haiku-4.5
