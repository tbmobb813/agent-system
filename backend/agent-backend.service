[Unit]
Description=Agent System Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/agent-system/backend
EnvironmentFile=/root/agent-system/backend/.env
ExecStart=/root/agent-system/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
