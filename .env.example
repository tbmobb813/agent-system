OPENROUTER_API_KEY= # Get from openrouter.ai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=ANON KEY

# Backend master keys (comma-separated). First key is a convenient default for local UI.
BACKEND_API_KEY=sk-agent-local-dev,sk-agent-telegram-bot

# If true, API keys (except master keys) always require PostgreSQL validation — even in development.
# REQUIRE_DATABASE_API_KEY=false

# Optional: E2B API key for code_execution tool in production.
# E2B_API_KEY=

# ── Connectors ────────────────────────────────────────────────────────────────
# GitHub — Personal Access Token (classic or fine-grained).
# Scopes needed: repo (read), issues (read/write) — https://github.com/settings/tokens
# GITHUB_TOKEN=

# Optional: restrict browser_automation to these host suffixes (comma-separated), after SSRF checks.
# Example: wikipedia.org,.github.io
# BROWSER_AUTOMATION_ALLOWED_HOST_SUFFIXES=

# Docker Compose — Next.js server proxies /api/backend to the API (not the browser).
BACKEND_URL=http://backend:8000

# Optional: protect proxied backend API traffic with HTTP Basic auth at the Next.js edge.
# Recommended when exposing the web UI publicly on a VPS.
# FRONTEND_REQUIRE_PROXY_AUTH=true
# FRONTEND_BASIC_AUTH_USER=agent
# FRONTEND_BASIC_AUTH_PASSWORD=change-me

# Optional: browser calls this URL directly instead of /api/backend (requires CORS on the API).
# NEXT_PUBLIC_API_URL=

# Optional Slack/Discord webhook bridge settings.
# SLACK_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# BOT_WEBHOOK_SECRET=
# BOT_WEBHOOK_ALLOW_INSECURE=false

# Optional quality-judge scoring (off by default).
# QUALITY_SCORING_ENABLED=false
# QUALITY_SCORING_SAMPLE_RATE=0.10
# QUALITY_SCORING_MODEL=anthropic/claude-3.5-haiku

# Optional: Redis URL when orchestration.message_queue.provider is redis (durable deferred tasks).
# REDIS_URL=redis://localhost:6379/0

# Optional: absolute path to agent_pillars.yaml if the backend runs with a different cwd (default: repo root).
# AGENT_PILLARS_PATH=/path/to/agent_pillars.yaml
