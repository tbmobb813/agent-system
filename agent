#!/usr/bin/env bash
# Agent system controller.
# Usage: agent [command]
#
#   agent / agent start   Start backend + frontend + Telegram bot
#   agent stop            Stop all services
#   agent status          Show what's running
#   agent logs [service]  Tail logs (backend / frontend / telegram)
#   agent tui             Launch the terminal UI (CLI)

set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="$ROOT/logs"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'
log()  { echo -e "${GREEN}[agent]${NC} $*"; }
warn() { echo -e "${YELLOW}[agent]${NC} $*"; }
die()  { echo -e "${RED}[agent]${NC} $*"; exit 1; }

cmd="${1:-start}"

case "$cmd" in

  start)
    exec "$ROOT/start.sh"
    ;;

  stop)
    exec "$ROOT/stop.sh"
    ;;

  status)
    echo ""
    # Backend
    if curl -sf http://localhost:8000/health > /dev/null 2>&1; then
      echo -e "  ${GREEN}●${NC} backend    http://localhost:8000"
    else
      echo -e "  ${RED}○${NC} backend    not running"
    fi
    # Frontend
    if curl -sf http://localhost:3003 > /dev/null 2>&1; then
      echo -e "  ${GREEN}●${NC} frontend   http://localhost:3003"
    else
      echo -e "  ${RED}○${NC} frontend   not running"
    fi
    # Telegram
    if systemctl is-active agent-telegram > /dev/null 2>&1; then
      echo -e "  ${GREEN}●${NC} telegram   systemd (active)"
    elif pgrep -f "bot.py" > /dev/null 2>&1; then
      echo -e "  ${GREEN}●${NC} telegram   running (pid $(pgrep -f 'bot.py'))"
    else
      echo -e "  ${RED}○${NC} telegram   not running"
    fi
    # PM2
    if command -v pm2 > /dev/null 2>&1; then
      echo ""
      pm2 list 2>/dev/null | grep -E "agent-|online|stopped" || true
    fi
    echo ""
    ;;

  logs)
    service="${2:-backend}"
    mkdir -p "$LOG_DIR"
    case "$service" in
      backend)
        if command -v pm2 > /dev/null 2>&1 && pm2 describe agent-backend > /dev/null 2>&1; then
          exec pm2 logs agent-backend
        else
          exec tail -f "$LOG_DIR/backend.log"
        fi
        ;;
      frontend)
        if command -v pm2 > /dev/null 2>&1 && pm2 describe agent-frontend > /dev/null 2>&1; then
          exec pm2 logs agent-frontend
        else
          exec tail -f "$LOG_DIR/frontend.log"
        fi
        ;;
      telegram|bot)
        if systemctl is-enabled agent-telegram > /dev/null 2>&1; then
          exec journalctl -u agent-telegram -f
        else
          exec tail -f "$LOG_DIR/telegram.log"
        fi
        ;;
      *)
        die "Unknown service: $service. Use: backend, frontend, telegram"
        ;;
    esac
    ;;

  tui|cli)
    VENV="$ROOT/.venv-cli"
    if [ ! -f "$VENV/bin/python" ]; then
      warn "CLI venv not found — setting up..."
      if command -v uv > /dev/null 2>&1; then
        uv venv "$VENV" --python 3.12
        uv pip install --python "$VENV/bin/python" -r "$ROOT/requirements-cli.txt"
      elif python3 -m venv --help > /dev/null 2>&1; then
        python3 -m venv "$VENV"
        "$VENV/bin/pip" install -q -r "$ROOT/requirements-cli.txt"
      else
        die "Cannot create venv. Run: sudo apt install python3.12-venv"
      fi
    fi
    exec "$VENV/bin/python" -m cli
    ;;

  help|--help|-h)
    echo ""
    echo "  agent                 Start backend + frontend + Telegram bot"
    echo "  agent start           Start everything (explicit)"
    echo "  agent stop            Stop all services"
    echo "  agent status          Check what's running"
    echo "  agent logs            Tail backend logs"
    echo "  agent logs frontend   Tail frontend logs"
    echo "  agent logs telegram   Tail Telegram bot logs"
    echo "  agent tui             Launch the terminal UI"
    echo ""
    ;;

  *)
    die "Unknown command: $cmd  (run 'agent help' for usage)"
    ;;

esac
